# ---------------------------------------------------------------------------
# Log
# ---------------------------------------------------------------------------
log_file_for() {
  case $1 in
    gateway) printf '%s/logs/gateway.log' "$HERMES_HOME" ;;
    errors) printf '%s/logs/errors.log' "$HERMES_HOME" ;;
    agent|admin|default) printf '%s/logs/agent.log' "$HERMES_HOME" ;;
    installer) printf '%s' "$KA_LOG" ;;
    *) if profile_exists "$1"; then printf '%s/logs/agent.log' "$(profile_home "$1")"; else return 1; fi ;;
  esac
}
show_log() { # show_log TARGET [follow]
  local t=$1 f tmp
  case $t in
    panel|dashboard) tmp=$(mktemp); journalctl -u "$KA_DASH_UNIT" -n 300 --no-pager 2>&1 | redact_stream >"$tmp" ;;
    kantor3d|ruang) tmp=$(mktemp); journalctl -u "$KA_RUANG_UNIT" -n 300 --no-pager 2>&1 | redact_stream >"$tmp" ;;
    pengawas) tmp=$(mktemp); grep -a 'pengawas' "$KA_LOG" 2>/dev/null | tail -300 >"$tmp" ;;
    *) f=$(log_file_for "$t") || { errp "Log tidak dikenal: $t"; return 1; }
       [[ -f $f ]] || { ui_msg "Belum ada log" "File $f belum ada." 8; return 0; }
       if [[ ${2:-} == follow ]]; then
         run_tty bash -c "printf 'Ctrl+C untuk berhenti\n\n'; tail -n 50 -F '$f' | sed -E 's#bot[0-9]+:[A-Za-z0-9_-]+#bot***#g'"
         return 0
       fi
       tmp=$(mktemp); tail -n 300 "$f" | redact_stream >"$tmp" ;;
  esac
  [[ -s $tmp ]] || echo "(kosong)" >"$tmp"
  ui_text "Log: $t" "$tmp"; rm -f "$tmp"
}
m_logs() {
  local c n
  while c=$(ui_menu "Log" "Lihat log (token & kunci disensor otomatis):" \
        1 "Gateway Hermes" 2 "Error Hermes" 3 "Admin (agent)" 4 "Karyawan tertentu" \
        5 "Panel Hermes" 6 "Kantor 3D" 7 "Pengawas" 8 "Installer / kantorai" \
        9 "Ikuti log gateway langsung"); do
    case $c in
      1) show_log gateway ;; 2) show_log errors ;; 3) show_log agent ;;
      4) n=$(pick_profile "Log karyawan:") && show_log "$n" ;;
      5) show_log panel ;; 6) show_log kantor3d ;; 7) show_log pengawas ;; 8) show_log installer ;;
      9) show_log gateway follow ;;
    esac
  done
}

# ---------------------------------------------------------------------------
# Backup & restore
# ---------------------------------------------------------------------------
do_backup_now() {
  local out
  ui_info "Membuat backup (konfigurasi, memori, sesi, skill semua karyawan)..."
  if out=$("$KA_LIBDIR/pengawas.sh" backup); then ui_msg "Backup selesai" "File: $out\nUkuran: $(du -h "$out" | cut -f1)\n\nSalin ke luar server, contoh dari laptop:\n  scp root@$(local_ip):$out ." 12
  else ui_msg "Backup gagal" "Lihat: kantorai logs installer" 8; return 1; fi
}
do_restore() {
  local f=${1:-} items=() x etc
  if [[ -z $f ]]; then
    while IFS= read -r x; do items+=("$x" "$(du -h "$x" | cut -f1) · $(date -r "$x" '+%F %H:%M')"); done \
      < <(ls -1t "$KA_BACKUP_DIR"/hermes-backup-*.zip 2>/dev/null)
    ((${#items[@]})) || { ui_msg "Tidak ada backup" "Belum ada file di $KA_BACKUP_DIR." 8; return 0; }
    f=$(ui_menu "Pulihkan backup" "Pilih backup (data Hermes sekarang akan ditimpa):" "${items[@]}") || return 0
  fi
  [[ -f $f ]] || { errp "File tidak ada: $f"; return 1; }
  ui_yesno "Pulihkan" "Pulihkan dari:\n$f\n\nKonfigurasi, memori, sesi, dan skill akan DITIMPA isi backup. Gateway dihentikan selama proses.\nLanjutkan?" no || return 0
  ui_info "Memulihkan..."
  hm gateway stop --system -y >>"$KA_LOG" 2>&1 || systemctl stop "$KA_GATEWAY_UNIT"
  if hm import "$f" -f >>"$KA_LOG" 2>&1; then
    etc="${f%.zip}-kantorai-etc.tgz"
    [[ -f $etc ]] && ui_yesno "Pengaturan kantorai" "Pulihkan juga pengaturan kantorai (port, mode akses, password web)?" no \
      && tar -xzf "$etc" -C / && ka_load_conf && ka_apply_web >>"$KA_LOG" 2>&1
    ka_install_branding
    systemctl start "$KA_GATEWAY_UNIT"
    ui_msg "Selesai" "Backup dipulihkan dan gateway dijalankan." 8
  else
    systemctl start "$KA_GATEWAY_UNIT"
    ui_msg "Gagal" "Pemulihan gagal. Lihat: kantorai logs installer" 8; return 1
  fi
}
m_backup() {
  local c
  while c=$(ui_menu "Backup & restore" "Backup otomatis: $KA_AUTO_BACKUP (tiap 07:05, simpan $KA_BACKUP_KEEP terakhir) · lokasi $KA_BACKUP_DIR" \
        1 "Backup sekarang" 2 "Daftar backup" 3 "Pulihkan dari backup" \
        4 "Backup otomatis on/off" 5 "Jumlah backup yang disimpan"); do
    case $c in
      1) do_backup_now ;;
      2) local t; t=$(mktemp); ls -lh "$KA_BACKUP_DIR" >"$t" 2>&1; ui_text "Daftar backup" "$t"; rm -f "$t" ;;
      3) do_restore ;;
      4) if [[ $KA_AUTO_BACKUP == yes ]]; then KA_AUTO_BACKUP=no; else KA_AUTO_BACKUP=yes; fi
         conf_set KA_AUTO_BACKUP "$KA_AUTO_BACKUP"; ui_msg "Backup otomatis" "Backup otomatis: $KA_AUTO_BACKUP" 8 ;;
      5) ui_input KA_BACKUP_KEEP "Simpan backup" "Jumlah backup harian yang disimpan:" "$KA_BACKUP_KEEP" valid_thread_id && conf_set KA_BACKUP_KEEP "$KA_BACKUP_KEEP" ;;
    esac
  done
}

