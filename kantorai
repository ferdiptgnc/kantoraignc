#!/usr/bin/env bash
#
# ============================================================================
#  kantorai — Menu pengelolaan GNC Kantor AI
#  Galura Nexa Core — Technology Infrastructure
# ============================================================================
#  Dipasang oleh install-kantorai.sh ke /usr/local/bin/kantorai.
#
#  Pemakaian (root):
#    kantorai                         menu interaktif
#    kantorai status                  ringkasan status kantor
#    kantorai restart [semua|gateway|panel|kantor3d|nginx]
#    kantorai karyawan [daftar|tambah|hapus NAMA]
#    kantorai model [NAMA]            pilih model AI (default = admin)
#    kantorai logs [gateway|errors|panel|kantor3d|pengawas|installer|NAMA]
#    kantorai backup                  backup sekarang
#    kantorai restore FILE.zip        pulihkan dari backup
#    kantorai pengawas [periksa|uji|status]
#    kantorai web [lokal|lan|password]
#    kantorai update [hermes|kantor3d|self]
#    kantorai doctor                  diagnosa
#    kantorai info                    alamat & info instalasi
#    kantorai uninstall               hapus GNC Kantor AI
#
#  Sumber: https://github.com/ferdiptgnc/kantoraignc
# ============================================================================

set -uo pipefail

KA_LIBDIR=${KA_LIBDIR:-/usr/local/lib/kantorai}
# shellcheck source=lib/common.sh
. "$KA_LIBDIR/common.sh" || { echo "GNC Kantor AI belum terpasang lengkap ($KA_LIBDIR/common.sh)." >&2; exit 1; }
# shellcheck source=lib/setup.sh
. "$KA_LIBDIR/setup.sh"

need_root() { [[ $EUID -eq 0 ]] || die "Jalankan sebagai root (sudo -i)."; }
ensure_tui() {
  # KA_PLAIN=1: menu teks biasa tanpa whiptail (terminal sederhana / pengujian)
  [[ ${KA_PLAIN:-0} == 1 ]] && { TUI=0; return 0; }
  command -v whiptail >/dev/null 2>&1 || die "whiptail tidak ada. Pasang: apt-get install -y whiptail"
  [[ -t 0 && -t 1 ]] || die "Menu butuh terminal interaktif. Lihat: kantorai help"
  TUI=1
}

# ---------------------------------------------------------------------------
# Status
# ---------------------------------------------------------------------------
fmt_state() {
  case $1 in
    active) printf 'aktif' ;; inactive) printf 'berhenti' ;; failed) printf 'GAGAL' ;;
    activating) printf 'memulai' ;; "") printf 'tidak terpasang' ;; *) printf '%s' "$1" ;;
  esac
}
unit_line() { # unit label [url]
  local s=""
  systemctl cat "$1" >/dev/null 2>&1 && s=$(svc_state "$1")
  printf '  %-24s %-15s %s\n' "$2" "$(fmt_state "$s")" "${3:-}"
}
crew_lines() {
  local p desc model bot envf
  for p in default $(list_profiles); do
    envf=$(profile_env "$p")
    desc=$(profile_desc "$p"); [[ $p == default ]] && desc=${desc:-asisten utama & admin}
    model=$(profile_model "$p")
    bot="-"; [[ -n $(envget "$envf" TELEGRAM_BOT_TOKEN) ]] && bot="bot ✓"
    printf '  %-14s %-7s %-22.22s %s\n' "$p" "$bot" "${model:-(model admin)}" "$desc"
  done
}
status_text() {
  local host ip disk mem up hv
  host=$(hostname); ip=$(local_ip)
  disk=$(df -P / | awk 'NR==2{print $5}')
  mem=$(awk '/^MemTotal/{t=$2} /^MemAvailable/{a=$2} END{printf "%d%%", (t-a)*100/t}' /proc/meminfo)
  up=$(uptime -p 2>/dev/null | sed 's/^up //')
  hv=$(hermes_ok && hm --version 2>/dev/null | head -1)
  local h; if [[ $KA_ACCESS_MODE == lan ]]; then h=$ip; else h=127.0.0.1; fi
  printf 'GNC Kantor AI v%s · %s\n' "$KA_VERSION" "$KA_OFFICE_NAME"
  printf 'Server : %s (%s) · uptime %s · disk %s · RAM %s\n' "$host" "$ip" "${up:-?}" "$disk" "$mem"
  printf 'Hermes : %s\n' "${hv:-TIDAK DITEMUKAN}"
  printf 'Akses  : %s\n\n' "$([[ $KA_ACCESS_MODE == lan ]] && echo "LAN (login $KA_WEB_USER)" || echo "lokal / SSH tunnel")"
  printf 'Layanan:\n'
  unit_line "$KA_GATEWAY_UNIT" "Gateway Hermes"
  [[ $KA_WITH_DASHBOARD == yes ]] && unit_line "$KA_DASH_UNIT" "Panel Hermes" "${KA_URL_DASHBOARD:-http://$h:$KA_DASH_PORT}"
  [[ $KA_WITH_RUANG == yes ]] && unit_line "$KA_RUANG_UNIT" "Kantor 3D" "${KA_URL_RUANG:-http://$h:$KA_RUANG_PORT}"
  [[ $KA_WITH_PORTAL == yes ]] && unit_line nginx "Portal (nginx)" "${KA_URL_PORTAL:-http://$h:$KA_PORTAL_PORT}"
  [[ $KA_WITH_PENGAWAS == yes ]] && unit_line "$KA_PENGAWAS_UNIT.timer" "Pengawas (timer)"
  [[ $KA_WITH_CLOUDFLARED == yes ]] && unit_line cloudflared "Cloudflare Tunnel"
  printf '\nKaryawan AI:\n'
  crew_lines
  if [[ -n $KA_TG_GROUP_ID ]]; then printf '\nGrup Telegram kantor: %s\n' "$KA_TG_GROUP_ID"; fi
}
do_status() {
  if ((TUI)); then
    local t; t=$(mktemp); status_text >"$t"; ui_text "Status kantor" "$t"; rm -f "$t"
  else status_text; fi
}

# ---------------------------------------------------------------------------
# Layanan
# ---------------------------------------------------------------------------
restart_target() {
  case ${1:-semua} in
    gateway) ui_info "Restart gateway (menunggu percakapan yang sedang berjalan selesai)..."; gateway_restart ;;
    panel|dashboard) systemctl restart "$KA_DASH_UNIT" ;;
    kantor3d|ruang) systemctl restart "$KA_RUANG_UNIT" ;;
    nginx|portal) ka_nginx_reload ;;
    semua|all)
      ui_info "Restart semua layanan..."
      gateway_restart
      [[ $KA_WITH_DASHBOARD == yes ]] && systemctl restart "$KA_DASH_UNIT"
      [[ $KA_WITH_RUANG == yes ]] && systemctl restart "$KA_RUANG_UNIT"
      ka_nginx_reload ;;
    *) errp "Target tidak dikenal: $1 (semua|gateway|panel|kantor3d|nginx)"; return 2 ;;
  esac
}
m_layanan() {
  local c
  while c=$(ui_menu "Layanan" "Kelola layanan kantor:" \
        1 "Restart SEMUA layanan" \
        2 "Restart gateway Hermes (bot Telegram)" \
        3 "Restart Panel Hermes" \
        4 "Restart Kantor 3D" \
        5 "Reload nginx (portal)" \
        6 "Hentikan gateway (semua bot diam)" \
        7 "Jalankan gateway" \
        8 "Pasang ulang service gateway" \
        9 "Status gateway (detail)"); do
    case $c in
      1) restart_target semua && ui_msg "Selesai" "Semua layanan di-restart." 8 ;;
      2) restart_target gateway && ui_msg "Selesai" "Gateway di-restart." 8 || ui_msg "Gagal" "Restart gateway gagal. Lihat Log -> gateway." 8 ;;
      3) restart_target panel && ui_msg "Selesai" "Panel Hermes di-restart." 8 ;;
      4) restart_target kantor3d && ui_msg "Selesai" "Kantor 3D di-restart." 8 ;;
      5) restart_target nginx && ui_msg "Selesai" "nginx di-reload." 8 ;;
      6) ui_yesno "Hentikan gateway" "Semua karyawan AI berhenti membalas Telegram dan jadwal (cron) tidak jalan.\nLanjutkan?" no \
           && { hm gateway stop --system -y >>"$KA_LOG" 2>&1 || systemctl stop "$KA_GATEWAY_UNIT"; ui_msg "Selesai" "Gateway dihentikan." 8; } ;;
      7) systemctl start "$KA_GATEWAY_UNIT" && ui_msg "Selesai" "Gateway dijalankan." 8 ;;
      8) ui_run "Pasang ulang gateway" hm gateway install --system --run-as-user root --force --start-now --start-on-login ;;
      9) ui_run "Status gateway" hm gateway status --system ;;
    esac
  done
}

# ---------------------------------------------------------------------------
# Karyawan AI
# ---------------------------------------------------------------------------
pick_profile() { # pick_profile "Teks" [with_default]  -> nama
  local items=() p desc
  [[ ${2:-} == default ]] && items+=(default "Asisten utama & admin")
  for p in $(list_profiles); do desc=$(profile_desc "$p"); items+=("$p" "${desc:-(tanpa jabatan)}"); done
  if ((${#items[@]} == 0)); then ui_msg "Belum ada karyawan" "Belum ada karyawan AI. Tambahkan dulu lewat menu Karyawan AI -> Tambah." 9; return 1; fi
  ui_menu "Pilih karyawan" "$1" "${items[@]}"
}

token_in_use() { # token_in_use TOKEN [kecuali_profil] -> nama profil pemakai
  local p
  for p in default $(list_profiles); do
    [[ $p == "${2:-}" ]] && continue
    [[ $(envget "$(profile_env "$p")" TELEGRAM_BOT_TOKEN) == "$1" ]] && { printf '%s' "$p"; return 0; }
  done
  return 1
}

# ask_bot_token VAR NAMA_PROFIL  -> token valid & belum dipakai profil lain
ask_bot_token() {
  local __v=$1 prof=$2 _tok _uname _owner
  while true; do
    ui_secret _tok "Token bot @$prof" \
"Buat bot baru di @BotFather (/newbot), lalu tempel tokennya di sini.
Satu karyawan = satu bot. Token tidak ditampilkan di layar.

Kosongkan untuk melewati (bot bisa diatur nanti)." || return 1
    [[ -z $_tok ]] && { printf -v "$__v" '%s' ""; return 0; }
    valid_bot_token "$_tok" || { ui_msg "Token tidak valid" "Format token: 123456789:AAH... (dari @BotFather)." 8; continue; }
    if _owner=$(token_in_use "$_tok" "$prof"); then
      ui_msg "Token sudah dipakai" "Token ini sudah dipakai karyawan '$_owner'.\nSatu bot hanya boleh untuk satu karyawan (kalau tidak, gateway menolak start)." 10; continue
    fi
    ui_info "Memeriksa token ke Telegram..."
    if _uname=$(tg_bot_username "$_tok"); then
      ui_msg "Bot ditemukan" "Token valid: @$_uname" 8
      printf -v "$__v" '%s' "$_tok"; BOT_USERNAME=$_uname; return 0
    fi
    ui_yesno "Token belum bisa dicek" "Telegram menolak token ini, atau server tidak bisa menghubungi api.telegram.org.\nTetap pakai token ini?" no \
      && { printf -v "$__v" '%s' "$_tok"; BOT_USERNAME=""; return 0; }
  done
}

write_soul() { # write_soul NAMA JABATAN TUGAS
  local f; f="$(profile_home "$1")/SOUL.md"
  NAMA=$1 JABATAN=$2 TUGAS=$3 KANTOR=$KA_OFFICE_NAME awk '
    { gsub(/\{\{NAMA\}\}/, ENVIRON["NAMA"]); gsub(/\{\{JABATAN\}\}/, ENVIRON["JABATAN"]);
      gsub(/\{\{TUGAS\}\}/, ENVIRON["TUGAS"]); gsub(/\{\{KANTOR\}\}/, ENVIRON["KANTOR"]); print }' \
    "$KA_HOME/assets/templates/SOUL.md.tpl" >"$f"
}

apply_bot_to_profile() { # apply_bot_to_profile NAMA TOKEN
  local envf users; envf=$(profile_env "$1")
  envset "$envf" TELEGRAM_BOT_TOKEN "$2"
  users=$(envget "$(profile_env default)" TELEGRAM_ALLOWED_USERS)
  if [[ -n $users ]]; then
    envset "$envf" TELEGRAM_ALLOWED_USERS "$users"
    [[ -n $(envget "$envf" TELEGRAM_HOME_CHANNEL) ]] || envset "$envf" TELEGRAM_HOME_CHANNEL "${users%%,*}"
  fi
}

do_add_employee() {
  local name="" jabatan="" tugas="" tok="" args=() thread=""
  BOT_USERNAME=""
  ui_input name "Tambah karyawan (1/5)" \
"Nama profil karyawan (huruf kecil, angka, - atau _; diawali huruf).
Nama ini juga jadi perintah terminal, contoh: sekretaris, sales, noc" \
    "" valid_profile "Nama tidak valid atau dipakai sistem. Contoh: sekretaris, sales_1, noc" || return 0
  if profile_exists "$name"; then ui_msg "Sudah ada" "Karyawan '$name' sudah ada." 8; return 0; fi
  # Hermes membuat perintah /root/.local/bin/<nama>; jangan sampai menutupi perintah sistem (curl, nano, ...)
  local sys_cmd; sys_cmd=$(type -P "$name" 2>/dev/null || true)
  if [[ -n $sys_cmd && $sys_cmd != "$KA_ROOT_HOME/.local/bin/"* ]]; then
    ui_msg "Nama bentrok" "Nama '$name' sama dengan perintah sistem ($sys_cmd).\nPilih nama lain, misalnya '${name}_ai'." 9; return 0
  fi
  ui_input jabatan "Tambah karyawan (2/5)" "Jabatan singkat, contoh: Sekretaris kantor, Admin penjualan, Teknisi NOC:" \
    "" valid_nonempty "Jabatan wajib diisi." || return 0
  ui_input tugas "Tambah karyawan (3/5)" \
"Tugas utamanya dalam satu-dua kalimat (bisa disempurnakan nanti di SOUL.md):
Contoh: Merangkum email masuk setiap pagi dan mengingatkan tenggat penawaran." \
    "" valid_nonempty "Tugas wajib diisi." || return 0
  args=(profile create "$name" --description "$jabatan")
  ui_yesno "Tambah karyawan (4/5)" \
"Aktifkan skill bawaan Hermes untuk '$name'?

Yes = skill bawaan aktif (riset web, dokumen, kode, dll).
No  = profil kosong tanpa skill, cocok untuk karyawan dengan tugas sempit." || args+=(--no-skills)

  ui_info "Membuat profil $name..."
  if ! hm "${args[@]}" </dev/null >>"$KA_LOG" 2>&1 || ! profile_exists "$name"; then
    ui_msg "Gagal" "Profil gagal dibuat. Lihat: kantorai logs installer" 8; return 1
  fi
  write_soul "$name" "$jabatan" "$tugas"

  ask_bot_token tok "$name" || tok=""
  [[ -n $tok ]] && apply_bot_to_profile "$name" "$tok"

  if [[ -n $tok && -n $KA_TG_GROUP_ID ]]; then
    if ui_yesno "Topik grup" "Buat topik baru bernama '$jabatan' di grup kantor untuk $name?\n\n(Bot admin harus admin grup dengan izin 'Manage Topics'.)"; then
      thread=$(create_topic "$jabatan") && apply_topics "$name" "$thread" \
        || ui_msg "Topik gagal dibuat" "Topik belum bisa dibuat. Atur nanti di Telegram -> Topik karyawan." 9
    fi
  fi

  if ui_yesno "Tambah karyawan (5/5)" "Model AI '$name' saat ini sama dengan admin.\n\nPilih model lain sekarang?" no; then
    run_tty hm -p "$name" model
  fi
  ui_info "Restart gateway agar $name mulai bekerja..."
  gateway_restart >>"$KA_LOG" 2>&1 || true
  "$KA_LIBDIR/pengawas.sh" periksa --diam >/dev/null 2>&1 || true

  local msg
  msg="Karyawan '$name' ($jabatan) sudah dibuat.

Perintah terminal : $name   (contoh: $name chat)
Kepribadian       : $(profile_home "$name")/SOUL.md"
  if [[ -n $tok ]]; then
    msg+="
Bot Telegram      : ${BOT_USERNAME:+@$BOT_USERNAME}

Langkah di Telegram:
  1. @BotFather -> /mybots -> bot ini -> Bot Settings -> Group Privacy -> Turn off
  2. Masukkan bot ke grup kantor dan jadikan admin (bila memakai grup)
  3. Kirim /start ke bot lewat DM untuk uji"
    [[ -n $thread ]] && msg+="
  4. Bot akan menjawab di topik baru (ID $thread)"
  else
    msg+="

Bot Telegram belum diatur: Karyawan AI -> Ganti token bot."
  fi
  ui_msg "Karyawan ditambahkan" "$msg" 22
}

do_delete_employee() {
  local name=${1:-} conf out
  [[ -n $name ]] || name=$(pick_profile "Karyawan yang akan DIHAPUS:") || return 0
  profile_exists "$name" && [[ $name != default ]] || { ui_msg "Tidak ada" "Karyawan '$name' tidak ditemukan." 8; return 1; }
  ui_yesno "Hapus karyawan" "Hapus karyawan '$name' beserta memori, sesi, skill, dan jadwalnya?\n\nArsip cadangan profil disimpan dulu di $KA_BACKUP_DIR." no || return 0
  if ((TUI)); then
    conf=$(whiptail --backtitle "$BT" --title "Konfirmasi" --inputbox "Ketik nama karyawan ($name) untuk konfirmasi:" 10 "$W" 3>&1 1>"$KA_TTY" 2>&3) || return 0
    [[ $conf == "$name" ]] || { ui_msg "Batal" "Nama tidak cocok, tidak ada yang dihapus." 8; return 0; }
  fi
  mkdir -p "$KA_BACKUP_DIR"
  out="$KA_BACKUP_DIR/profil-$name-$(date +%Y%m%d-%H%M%S).tar.gz"
  ui_info "Mengarsipkan profil $name..."
  hm profile export "$name" -o "$out" >>"$KA_LOG" 2>&1 && chmod 600 "$out" || out=""
  if hm profile delete "$name" -y >>"$KA_LOG" 2>&1; then
    gateway_restart >>"$KA_LOG" 2>&1 || true
    ui_msg "Dihapus" "Karyawan '$name' dihapus.${out:+\nArsip: $out\n(Pulihkan dengan: hermes profile import $out)}" 11
  else
    ui_msg "Gagal" "Gagal menghapus '$name'. Lihat: kantorai logs installer" 8
  fi
}

do_edit_soul() {
  local name f desc
  name=$(pick_profile "Ubah jabatan & kepribadian karyawan:" default) || return 0
  f="$(profile_home "$name")/SOUL.md"
  desc=$(profile_desc "$name")
  if [[ $name != default ]] && ui_input desc "Jabatan" "Jabatan singkat '$name':" "$desc" valid_nonempty; then
    hm profile describe "$name" --text "$desc" >>"$KA_LOG" 2>&1 || true
  fi
  ui_msg "Edit SOUL.md" "File kepribadian & aturan '$name' akan dibuka di editor nano.\n\nSimpan: Ctrl+O lalu Enter · Keluar: Ctrl+X\nPerubahan berlaku di percakapan baru (/new) setelah gateway di-restart." 11
  run_tty nano "$f"
  ui_yesno "Restart gateway" "Restart gateway sekarang agar perubahan langsung berlaku?" && gateway_restart >>"$KA_LOG" 2>&1
}

do_change_token() {
  local name tok
  name=$(pick_profile "Ganti token bot Telegram untuk:" default) || return 0
  BOT_USERNAME=""
  ask_bot_token tok "$name" || return 0
  if [[ -z $tok ]]; then
    ui_yesno "Lepas bot" "Lepas bot Telegram dari '$name'? (karyawan tetap ada, hanya tidak terhubung ke Telegram)" no || return 0
    envdel "$(profile_env "$name")" TELEGRAM_BOT_TOKEN
  else
    apply_bot_to_profile "$name" "$tok"
  fi
  gateway_restart >>"$KA_LOG" 2>&1 || true
  ui_msg "Selesai" "Token bot '$name' diperbarui dan gateway di-restart." 8
}

do_test_chat() {
  local name q
  name=$(pick_profile "Uji jawaban karyawan:" default) || return 0
  ui_input q "Uji chat" "Pertanyaan untuk $name:" "Perkenalkan dirimu dan tugasmu dalam 3 kalimat." valid_nonempty || return 0
  ui_info "Menunggu jawaban $name (bisa 10-60 detik)..."
  ui_run "Jawaban $name" timeout 180 hm -p "$name" chat -Q -q "$q"
}

m_karyawan() {
  local c n
  while c=$(ui_menu "Karyawan AI" "Kelola karyawan AI (satu karyawan = satu profil Hermes + satu bot):" \
        1 "Daftar karyawan" \
        2 "Tambah karyawan" \
        3 "Ubah jabatan & kepribadian (SOUL.md)" \
        4 "Ganti model AI karyawan" \
        5 "Ganti / lepas token bot Telegram" \
        6 "Uji jawaban karyawan" \
        7 "Chat langsung di terminal" \
        8 "Skill karyawan (katalog Hermes)" \
        9 "Hapus karyawan"); do
    case $c in
      1) local t; t=$(mktemp); { printf '  %-14s %-7s %-22s %s\n' NAMA BOT MODEL JABATAN; crew_lines; } >"$t"; ui_text "Daftar karyawan" "$t"; rm -f "$t" ;;
      2) do_add_employee ;;
      3) do_edit_soul ;;
      4) n=$(pick_profile "Ganti model AI untuk:" default) && run_tty hm -p "$n" model && gateway_restart >>"$KA_LOG" 2>&1 ;;
      5) do_change_token ;;
      6) do_test_chat ;;
      7) n=$(pick_profile "Chat langsung dengan:" default) && run_tty hm -p "$n" ;;
      8) n=$(pick_profile "Kelola skill untuk:" default) && run_tty hm -p "$n" skills browse ;;
      9) do_delete_employee ;;
    esac
  done
}

# ---------------------------------------------------------------------------
# Telegram: grup forum & topik
# ---------------------------------------------------------------------------
admin_token() { envget "$(profile_env default)" TELEGRAM_BOT_TOKEN; }

# Deteksi ID grup: hentikan gateway sebentar, baca getUpdates bot admin (tanpa
# mengonfirmasi update, jadi pesan tetap diterima Hermes setelah gateway jalan).
detect_group() {
  local tok j end ids
  tok=$(admin_token); [[ -n $tok ]] || { ui_msg "Bot admin belum ada" "Atur dulu token bot admin." 8; return 1; }
  ui_yesno "Deteksi grup" \
"Langkah:
  1. Buat grup Telegram, aktifkan Topics (Edit grup -> Topics).
  2. Masukkan bot admin ke grup, jadikan admin (izin Manage Topics).
  3. Pilih Yes, lalu dalam 90 detik kirim pesan apa saja di grup itu.

Gateway dihentikan sebentar selama deteksi (bot diam maksimal 90 detik)." || return 1
  hm gateway stop --system -y >>"$KA_LOG" 2>&1 || systemctl stop "$KA_GATEWAY_UNIT"
  end=$(( $(date +%s) + 90 )); ids=""
  while (( $(date +%s) < end )); do
    ((TUI)) && whiptail --backtitle "$BT" --title "Deteksi grup" --infobox "Menunggu pesan di grup... sisa $(( end - $(date +%s) )) detik" 7 "$W" >"$KA_TTY"
    j=$(tg_call "$tok" getUpdates -d timeout=10 2>/dev/null) || { sleep 3; continue; }
    ids=$(jq -r '[.result[] | (.message // .my_chat_member // .channel_post // {}) | .chat? | select(.type? == "supergroup") | "\(.id)\t\(.title)"] | unique | .[]' <<<"$j" 2>/dev/null)
    [[ -n $ids ]] && break
    sleep 2
  done
  systemctl start "$KA_GATEWAY_UNIT" >>"$KA_LOG" 2>&1
  [[ -n $ids ]] || { ui_msg "Tidak terdeteksi" "Tidak ada pesan grup yang masuk. Pastikan grup sudah supergroup dengan Topics, bot sudah di dalamnya, dan privacy mode bot dimatikan." 10; return 1; }
  local items=() id title
  while IFS=$'\t' read -r id title; do items+=("$id" "$title"); done <<<"$ids"
  ui_menu "Pilih grup" "Grup yang terdeteksi:" "${items[@]}"
}

check_group() { # check_group CHAT_ID -> pesan status
  local tok j me forum st topics
  tok=$(admin_token)
  j=$(tg_call "$tok" getChat --data-urlencode "chat_id=$1") || { printf 'Bot admin tidak bisa membaca grup %s (belum jadi anggota?).' "$1"; return 1; }
  forum=$(jq -r '.result.is_forum // false' <<<"$j")
  me=$(tg_call "$tok" getMe | jq -r '.result.id')
  j=$(tg_call "$tok" getChatMember --data-urlencode "chat_id=$1" -d "user_id=$me")
  st=$(jq -r '.result.status // "?"' <<<"$j")
  topics=$(jq -r '.result.can_manage_topics // false' <<<"$j")
  printf 'Grup %s\n  Topics aktif   : %s\n  Status bot     : %s\n  Kelola topik   : %s\n' "$1" \
    "$([[ $forum == true ]] && echo ya || echo "TIDAK (aktifkan Topics)")" "$st" \
    "$([[ $topics == true ]] && echo ya || echo "TIDAK (beri izin Manage Topics)")"
  [[ $forum == true && $st == administrator && $topics == true ]]
}

create_topic() { # create_topic NAMA -> thread id (pakai bot admin)
  local tok j
  tok=$(admin_token); [[ -n $tok && -n $KA_TG_GROUP_ID ]] || return 1
  j=$(tg_call "$tok" createForumTopic --data-urlencode "chat_id=$KA_TG_GROUP_ID" --data-urlencode "name=$1") || return 1
  jq -er '.result.message_thread_id' <<<"$j"
}

apply_topics() { # apply_topics NAMA "id1,id2"
  local envf users first=${2%%,*}
  envf=$(profile_env "$1")
  users=$(envget "$(profile_env default)" TELEGRAM_ALLOWED_USERS)
