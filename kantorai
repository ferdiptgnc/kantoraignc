  tmp=$(mktemp -d /tmp/kantorai-up.XXXXXX)
  ui_info "Mengunduh versi terbaru kantorai ($KA_REPO@$KA_BRANCH)..."
  curl -fsSL --retry 3 "https://codeload.github.com/$KA_REPO/tar.gz/refs/heads/$KA_BRANCH" -o "$tmp/src.tgz" \
    && tar -xzf "$tmp/src.tgz" -C "$tmp" || { errp "Gagal mengunduh pembaruan"; return 1; }
  src=$(find "$tmp" -mindepth 1 -maxdepth 1 -type d | head -1)
  [[ -f $src/install-kantorai.sh ]] || { errp "Paket pembaruan tidak lengkap"; return 1; }
  ((TUI)) && clear
  bash "$src/install-kantorai.sh" --repair --source "$src"
  local rc=$?
  ((TUI)) && { printf '\nTekan Enter untuk kembali...'; read -r _; }
  rm -rf "$tmp"
  ((rc == 0)) && exec "$KA_BINDIR/kantorai"
  return $rc
}
m_update() {
  local c
  while c=$(ui_menu "Update" "Versi kantorai $KA_VERSION · Hermes: $(hm --version 2>/dev/null | head -1)" \
        1 "Update Hermes Agent" 2 "Update Kantor 3D" 3 "Update menu kantorai (dari GitHub)"); do
    case $c in
      1) update_hermes ;;
      2) update_ruang && ui_msg "Selesai" "Kantor 3D diperbarui." 8 || ui_msg "Gagal" "Lihat: kantorai logs installer" 8 ;;
      3) update_self ;;
    esac
  done
}

# ---------------------------------------------------------------------------
# Diagnosa & info
# ---------------------------------------------------------------------------
diag_text() {
  printf '== Port yang dipakai layanan kantor ==\n'
  ss -Hltnp 2>/dev/null | awk '{print $4, $6}' | grep -E ":($KA_PORTAL_PORT|$KA_RUANG_PORT|$KA_RUANG_INTERNAL_PORT|$KA_DASH_PORT) " || echo "(tidak ada)"
  printf '\n== hermes gateway status ==\n'; hm gateway status --system 2>&1 | tail -25
  printf '\n== hermes doctor ==\n'; timeout 120 hm doctor 2>&1 | tail -60
  printf '\n== nginx -t ==\n'; nginx -t 2>&1
}
do_info() {
  local t; t=$(mktemp)
  { ka_urls_text; printf '\n'; cat "$KA_INFO" 2>/dev/null; printf '\nFolder program : %s\nPengaturan     : %s\nBackup         : %s\n' "$KA_HOME" "$KA_CONF" "$KA_BACKUP_DIR"; } >"$t"
  if ((TUI)); then ui_text "Info instalasi" "$t"; else cat "$t"; fi
  rm -f "$t"
}

do_uninstall() {
  local a
  printf '%sMenghapus GNC Kantor AI dari server ini.%s\n' "$C_YLW" "$C_RST"
  printf 'Yang dihapus: menu kantorai, Panel/Kantor 3D/Pengawas service, konfigurasi nginx, portal.\n'
  printf 'Data Hermes (%s) dan backup (%s) TIDAK dihapus kecuali dipilih di bawah.\n\n' "$HERMES_HOME" "$KA_BACKUP_DIR"
  read -r -p "Ketik HAPUS untuk melanjutkan: " a; [[ $a == HAPUS ]] || { echo "Batal."; return 0; }
  systemctl disable --now "$KA_DASH_UNIT" "$KA_RUANG_UNIT" "$KA_PENGAWAS_UNIT.timer" "$KA_PENGAWAS_UNIT-harian.timer" >/dev/null 2>&1 || true
  rm -f "$KA_SYSTEMD_DIR/$KA_DASH_UNIT.service" "$KA_SYSTEMD_DIR/$KA_RUANG_UNIT.service" \
        "$KA_SYSTEMD_DIR/$KA_PENGAWAS_UNIT".{service,timer} "$KA_SYSTEMD_DIR/$KA_PENGAWAS_UNIT-harian".{service,timer}
  rm -f "$KA_NGINX_CONF"; ka_nginx_reload || true
  rm -rf "$KA_WWW" "$HERMES_HOME/plugins/$KA_PLUGIN_NAME" "$HERMES_HOME/dashboard-themes/gnc.yaml"
  read -r -p "Hapus juga Kantor 3D (Ruang)? [y/N] " a
  if [[ $a =~ ^[Yy] ]]; then curl -fsSL "$KA_RUANG_INSTALL_URL" | env -u RUANG_BIN -u RUANG_HOME HOME=$KA_ROOT_HOME bash -s -- --uninstall || true; fi
  read -r -p "Hapus juga Hermes Agent BESERTA semua karyawan & datanya? [y/N] " a
  if [[ $a =~ ^[Yy] ]]; then
    hm gateway uninstall --system >/dev/null 2>&1 || true
    hm uninstall || true
  fi
  systemctl daemon-reload
  rm -rf "$KA_HOME" "$KA_LIBDIR" "$KA_ETC" "$KA_PROFILE_D/kantorai.sh" "$KA_BINDIR/kantorai"
  echo "GNC Kantor AI dihapus. Backup tetap ada di $KA_BACKUP_DIR."
}

# ---------------------------------------------------------------------------
# Menu utama & CLI
# ---------------------------------------------------------------------------
main_menu() {
  ensure_tui
  local c
  while true; do
    c=$(ui_menu "GNC Kantor AI · $KA_OFFICE_NAME" "Karyawan: $(( $(list_profiles | wc -l) )) · Gateway: $(fmt_state "$(svc_state "$KA_GATEWAY_UNIT")") · Akses: $KA_ACCESS_MODE" \
        1  "Status kantor" \
        2  "Karyawan AI (tambah, ubah, hapus)" \
        3  "Layanan (restart, start, stop)" \
        4  "Model AI admin" \
        5  "Telegram (bot, grup, topik)" \
        6  "Web, akses & branding" \
        7  "Log" \
        8  "Backup & restore" \
        9  "Pengawas" \
        10 "Update" \
        11 "Diagnosa" \
        12 "Info instalasi" \
        0  "Keluar") || break
    case $c in
      1) do_status ;; 2) m_karyawan ;; 3) m_layanan ;;
      4) run_tty hm model && gateway_restart >>"$KA_LOG" 2>&1 ;;
      5) m_telegram ;; 6) m_web ;; 7) m_logs ;; 8) m_backup ;; 9) m_pengawas ;; 10) m_update ;;
      11) ui_run "Diagnosa" diag_text ;; 12) do_info ;; 0) break ;;
    esac
  done
  clear
}

usage() { sed -n '9,26p' "$0" | sed 's/^#  \{0,1\}//'; }

cli() {
  local cmd=${1:-}; shift || true
  case $cmd in
    "") main_menu ;;
    status) do_status ;;
    restart) restart_target "${1:-semua}" ;;
    karyawan)
      case ${1:-daftar} in
        daftar|list) printf '  %-14s %-7s %-22s %s\n' NAMA BOT MODEL JABATAN; crew_lines ;;
        tambah|add) ensure_tui; do_add_employee; clear ;;
        hapus|del) ensure_tui; do_delete_employee "${2:-}"; clear ;;
        *) die "kantorai karyawan [daftar|tambah|hapus NAMA]" ;;
      esac ;;
    model) local n=${1:-default}; profile_exists "$n" || die "Karyawan '$n' tidak ada"; hm -p "$n" model && gateway_restart ;;
    logs|log) show_log "${1:-gateway}" "${2:-}" ;;
    backup) "$KA_LIBDIR/pengawas.sh" backup ;;
    restore) [[ -n ${1:-} ]] || die "kantorai restore FILE.zip"; do_restore "$1" ;;
    pengawas) "$KA_LIBDIR/pengawas.sh" "${1:-status}" ;;
    web)
      case ${1:-} in
        lokal|local) KA_ACCESS_MODE=local; apply_web_now; ka_urls_text ;;
        lan) [[ -s $KA_HTPASSWD ]] || die "Password web belum ada. Jalankan: kantorai web password"; KA_ACCESS_MODE=lan; apply_web_now; ka_urls_text ;;
        password) ensure_tui; KA_ACCESS_MODE=lan; ui_pass KA_WEB_PASS "Password web" 10 && { info_set "Login web (password)" "$KA_WEB_PASS"; apply_web_now; }; clear; ka_urls_text ;;
        *) ka_urls_text ;;
      esac ;;
    update)
      case ${1:-} in
        hermes) update_hermes ;; kantor3d|ruang) update_ruang ;; self|kantorai) update_self ;;
        *) die "kantorai update [hermes|kantor3d|self]" ;;
      esac ;;
    doctor|diagnosa) diag_text ;;
    info) do_info ;;
    uninstall) do_uninstall ;;
    version|-v|--version) echo "GNC Kantor AI $KA_VERSION" ;;
    help|-h|--help) usage ;;
    *) errp "Perintah tidak dikenal: $cmd"; usage; exit 2 ;;
  esac
}

need_root
ka_load_conf
cli "$@"
